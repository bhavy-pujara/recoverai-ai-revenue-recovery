{
  "name": "recoverai-monorepo",
  "version": "1.0.0",
  "description": "RecoverAI — Intelligent Payment Revenue Recovery Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "vercel-build": "prisma generate --schema=prisma/schema.prisma && npm --prefix backend install && npm --prefix frontend install && npm --prefix backend run build && npm --prefix frontend run build",
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install && npm --prefix backend run db:push && npm run db:seed",
    "test": "npm --prefix backend run test",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx ts-node prisma/seed.ts"
  },
  "keywords": [
    "fintech",
    "revenue-recovery",
    "payments",
    "ai",
    "express",
    "react",
    "prisma"
  ],
  "author": "RecoverAI Team",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.24",
    "concurrently": "^8.2.2",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.0",
    "zod": "^4.5.4"
  }
}
