{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "api/**/*",
    "backend/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "backend/src/tests"
  ]
}
